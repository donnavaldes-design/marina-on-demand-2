{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "pdf/fonts/**"
        ]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/about/?",
      "dest": "/public/about.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/terms/?",
      "dest": "/public/terms.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scheduled-marina",
      "schedule": "0 12 * * *"
    }
  ]
}
